# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peakrent

# Signing keys (set your own values in production)
SECRET_KEY=change-me
JWT_SECRET=change-me

# OpenAI: tips for recommendations and the AI chat. Without a key the app falls back to rule-based texts.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenWeatherMap. Without a key the app uses demo weather.
OPENWEATHER_API_KEY=

# true: no email is sent and every code is 123456 (local development)
DEV_OTP_BYPASS=true

# Email codes through SMTP (used when DEV_OTP_BYPASS=false)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Kaspi Business API (optional; payments run in demo mode without it)
KASPI_API_KEY=
KASPI_MERCHANT_ID=
KASPI_WEBHOOK_SECRET=
